{
  "name": "lifelink-backend",
  "version": "1.0.0",
  "description": "LifeLink Emergency Blood Donation Backend REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:verification-profile-changes": "node --test src/scripts/test-verification-profile-changes.js",
    "test:verification-queue": "node src/scripts/test-verification-queue-crud.js",
    "test:emergency-contacts": "node src/scripts/test-emergency-contact-crud.js",
    "test:blood-stock-city": "node --test src/scripts/test-blood-stock-city-notifications.js",
    "test:blood-stock": "node src/scripts/test-blood-stock-crud.js",
    "test:db": "node src/scripts/test-db-connection.js",
    "verify:supabase": "node src/scripts/verify-supabase-crud.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "test:email": "node src/scripts/test-email-connection.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "prisma": "^6.4.0"
  }
}
