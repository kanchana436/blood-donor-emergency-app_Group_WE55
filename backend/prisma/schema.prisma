generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  phone           String
  password        String
  role            String           @default("donor")
  isActive        Boolean          @default(true)
  fcmToken        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bloodRequests   BloodRequest[]
  donationRecords DonationRecord[]
  donorProfile    DonorProfile?
  donorResponses  DonorResponse[]
  notifications   Notification[]
}

model DonorProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  bloodGroup        String
  isAvailable       Boolean   @default(true)
  city              String
  address           String    @default("")
  latitude          Float     @default(6.9271)
  longitude         Float     @default(79.8612)
  lastDonationDate  DateTime?
  totalDonations    Int       @default(0)
  livesSaved        Int       @default(0)
  eligibilityStatus String    @default("Eligible")
  weightKg          Float?
  medicalConditions String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BloodRequest {
  id              String          @id @default(uuid())
  requesterId     String
  requesterName   String
  patientName     String
  bloodGroup      String
  unitsRequired   Int             @default(1)
  urgency         String          @default("Emergency")
  hospitalName    String
  hospitalAddress String
  latitude        Float           @default(6.9271)
  longitude       Float           @default(79.8612)
  contactPhone    String
  additionalNotes String          @default("")
  status          String          @default("Open")
  requiredBefore  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  requester       User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  responses       DonorResponse[]
}

model DonorResponse {
  id              String       @id @default(uuid())
  requestId       String
  donorId         String
  donorName       String
  donorPhone      String
  donorBloodGroup String
  status          String       @default("Pending")
  distanceKm      Float        @default(2.5)
  note            String?
  respondedAt     DateTime     @default(now())
  donor           User         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  request         BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model DonationRecord {
  id             String   @id @default(uuid())
  donorId        String
  requestId      String
  hospitalName   String
  patientName    String
  bloodGroup     String
  units          Int      @default(1)
  donationDate   DateTime @default(now())
  status         String   @default("Completed")
  certificateUrl String?
  donor          User     @relation(fields: [donorId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String   @id @default(uuid())
  userId           String
  title            String
  message          String
  type             String   @default("emergency")
  isRead           Boolean  @default(false)
  relatedRequestId String?
  timestamp        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
