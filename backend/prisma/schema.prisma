generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                     String              @id @default(uuid())
  idNumber               String              @unique @map("id_number")
  name                   String
  email                  String              @unique
  phone                  String
  password               String
  role                   String              @default("donor") // "donor", "recipient", "manager"
  isActive               Boolean             @default(true)
  isEmailVerified        Boolean             @default(false) @map("is_email_verified")
  fcmToken               String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  bloodRequests          BloodRequest[]
  donationRecords        DonationRecord[]
  donorProfile           DonorProfile?
  donorResponses         DonorResponse[]
  notifications          Notification[]
  emergencyContacts      EmergencyContact[]
  submittedVerifications VerificationQueue[] @relation("VerificationSubmitter")
  reviewedVerifications  VerificationQueue[] @relation("VerificationReviewer")
}

model DonorProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  bloodGroup        String
  isAvailable       Boolean   @default(true)
  city              String
  address           String    @default("")
  latitude          Float     @default(6.9271)
  longitude         Float     @default(79.8612)
  lastDonationDate  DateTime?
  totalDonations    Int       @default(0)
  livesSaved        Int       @default(0)
  eligibilityStatus String    @default("Eligible")
  weightKg          Float?
  medicalConditions String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BloodRequest {
  id              String          @id @default(uuid())
  requesterId     String
  requesterName   String
  patientName     String
  bloodGroup      String
  unitsRequired   Int             @default(1)
  urgency         String          @default("Emergency")
  hospitalName    String
  hospitalAddress String
  latitude        Float           @default(6.9271)
  longitude       Float           @default(79.8612)
  contactPhone    String
  additionalNotes String          @default("")
  status          String          @default("Open")
  requiredBefore  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  requester       User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  responses       DonorResponse[]
}

model DonorResponse {
  id              String       @id @default(uuid())
  requestId       String
  donorId         String
  donorName       String
  donorPhone      String
  donorBloodGroup String
  status          String       @default("Pending")
  distanceKm      Float        @default(2.5)
  note            String?
  respondedAt     DateTime     @default(now())
  donor           User         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  request         BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model DonationRecord {
  id             String   @id @default(uuid())
  donorId        String
  requestId      String
  hospitalName   String
  patientName    String
  bloodGroup     String
  units          Int      @default(1)
  donationDate   DateTime @default(now())
  status         String   @default("Completed")
  certificateUrl String?
  donor          User     @relation(fields: [donorId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String   @id @default(uuid())
  userId           String
  title            String
  message          String
  type             String   @default("emergency")
  isRead           Boolean  @default(false)
  relatedRequestId String?
  timestamp        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationOtp {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model BloodStock {
  id             String   @id @default(uuid())
  bloodGroup     String
  availableUnits Int      @default(0)
  location       String
  status         String   @default("Available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([bloodGroup, location])
}

model EmergencyContact {
  id             String   @id @default(uuid())
  userId         String
  fullName       String
  relationship   String
  phone          String
  alternatePhone String?
  address        String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
}

model VerificationQueue {
  id               String    @id @default(uuid())
  submittedById    String
  verificationType String
  referenceId      String?
  title            String
  description      String?
  status           String    @default("Pending")
  managerNote      String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  oldValues        Json?
  newValues        Json?
  changedFields    Json?

  submittedBy User  @relation("VerificationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([reviewedById])
}
