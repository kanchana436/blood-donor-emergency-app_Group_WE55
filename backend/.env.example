PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL="postgresql://postgres.tckkwlfzvlzayskjierx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT Secret
JWT_SECRET="lifelink_jwt_secret_change_in_production"

# ==============================================================================
# EMAIL / SMTP CONFIGURATION (Required for real Forgot Password OTP delivery)
# ==============================================================================
# For Gmail:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Fill in SMTP_USER and SMTP_PASS (or SMTP_PASSWORD):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
EMAIL_FROM="LifeLink Security" <your-email@gmail.com>

# Optional email service name (e.g. 'gmail', 'SendGrid', 'Mailgun')
# EMAIL_SERVICE=gmail
